# Required: create an internal Notion integration and share the target page/database with it.
NOTION_TOKEN=secret_xxx

# Choose one parent target. Parent page is easiest because it requires no database schema.
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# If using a database, this title property must exist in the database.
NOTION_TITLE_PROPERTY=Name

# Local export directory produced by ninebot-dump/export/export_trips.py.
NINEBOT_EXPORT_DIR=ninebot-dump/export

# Optional: command used to call the real Ninebot native tokenRequest/signer.
# The command receives JSON payload on stdin and must print plaintext JSON response on stdout.
# Without this, --fetch-ninebot-online intentionally fails with a clear message.
NINEBOT_TOKENREQUEST_COMMAND=
